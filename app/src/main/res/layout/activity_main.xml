<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6DBFB"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imColorPicker"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:padding="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/editbox_background" />

    <Button
        android:id="@+id/circulo"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:text="Circulo"
        android:textSize="10dp"
        app:layout_constraintBottom_toBottomOf="@id/imColorPicker"
        app:layout_constraintEnd_toStartOf="@+id/quadrado"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/imColorPicker"
        app:layout_constraintTop_toTopOf="@id/imColorPicker" />

    <Button
        android:id="@+id/quadrado"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:text="Quadrado"
        android:textSize="10dp"
        app:layout_constraintBottom_toBottomOf="@id/imColorPicker"
        app:layout_constraintEnd_toStartOf="@+id/linha"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/circulo"
        app:layout_constraintTop_toTopOf="@id/imColorPicker" />

    <Button
        android:id="@+id/linha"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:text="Linha"
        android:textSize="10dp"
        app:layout_constraintBottom_toBottomOf="@id/imColorPicker"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/quadrado"
        app:layout_constraintTop_toTopOf="@id/imColorPicker" />

    <Button
        android:id="@+id/limpar"
        android:layout_width="389dp"
        android:layout_height="43dp"
        android:layout_marginTop="12dp"
        android:text="Limpar"
        android:textSize="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imColorPicker" />

    <com.example.myapplication.SimplePaint
        android:id="@+id/simplePaint"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/limpar" />

</androidx.constraintlayout.widget.ConstraintLayout>
